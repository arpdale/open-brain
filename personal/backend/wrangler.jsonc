{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-brain-neon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "SLACK_REPLIES_ENABLED": "false",
    "WRITES_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://claude.ai,https://hey-otis.vercel.app"
  },
  "queues": {
    "producers": [
      {
        "binding": "ENRICHMENT_QUEUE",
        "queue": "open-brain-enrichment"
      }
    ],
    "consumers": [
      {
        "queue": "open-brain-enrichment",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "open-brain-enrichment-dlq",
        "retry_delay": 60
      }
    ]
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
