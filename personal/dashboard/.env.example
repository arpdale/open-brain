# Open Brain Personal Dashboard — required environment variables.
#
# Local dev: configure this directory's .env.local.
# Production: set these in Vercel project env settings.
#
# Server-only Neon URL for the SELECT-only open_brain_dashboard role.
DATABASE_URL=
OPENROUTER_API_KEY=

# Neon Auth email-code login; server-only configuration.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
BRAIN_OWNER_EMAIL=

# Edit / soft-delete via the authenticated update-thought Worker endpoint.
# UPDATE_THOUGHT_URL: full https URL of the deployed function.
# UPDATE_THOUGHT_SECRET: shared secret, must match the function's env var of
# the same name. Server-only — never exposed to the browser.
UPDATE_THOUGHT_URL=
UPDATE_THOUGHT_SECRET=
